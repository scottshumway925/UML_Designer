<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UIInterationTests.App"
             xmlns:local="using:UIInterationTests"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://UIInterationTests/Styles/NodeStyles.axaml"/>
        <StyleInclude Source="avares://UIInterationTests/Styles/RootCanvasStyles.axaml"/>
    </Application.Styles>
</Application>