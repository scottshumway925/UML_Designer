<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UML_Designer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UML_Designer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="UML_Designer"
        KeyDown="OnKeyboardKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Sidebar Button Styling -->
		<Style Selector="Button.SideBarButton">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 2 Rows Here -->
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- 2 Columns Here -->
			<ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top Tool Bar -->
        <Border Background="#2D2D30" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
				<Button Content="Place" Click="OnSelectClicked" Classes="TopBarButton"/>
                <Button Content="Select" Click="OnSelectClicked" Classes="TopBarButton"/>
                <Button Content="Edit" Click="OnSelectClicked" Classes="TopBarButton"/>
                <Button Content="Save" Click="OnSelectClicked" Classes="TopBarButton"/>
                <Button Content="Load" Click="OnSelectClicked" Classes="TopBarButton"/>
                <Button Content="Change Diagram" Click="OnSelectClicked" Classes="TopBarButton"/>
            </StackPanel>
        </Border>

        <!-- UML Designer Text -->
        <Border Background="#2D2D30">
		    <TextBlock Text="UML DESIGNER" Foreground="White" Grid.Column="0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>	
        </Border>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" Grid.Row="1" FlowDirection="RightToLeft">
            <StackPanel Grid.Column="0" Background="#2D2D30" Spacing="10" FlowDirection="LeftToRight">

                <Button Content="Select" Click="OnSelectClicked" Classes="SideBarButton"/>
                <Button Content="CreateClassNode" Click="OnCreateClassNodeClicked" Classes="SideBarButton"/>
                <Button Content="CreateInterfaceNode" Click="OnCreateInterfaceNodeClicked" Classes="SideBarButton"/>
                <Button Content="Connect" Click="OnConnectClicked" Classes="SideBarButton"/>
                <Button Content="ScrollbarLengthTest" Click="OnConnectClicked" Classes="SideBarButton"/>
                <Button Content="LengthTest2" Click="OnConnectClicked" Classes="SideBarButton"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Scrollable Canvas for UML Diagrams -->
        <ScrollViewer Grid.Column="1" Grid.Row="1">
			<ItemsControl x:Name="UMLCanvas"
                          Classes="UMLCanvas"
                          ItemsSource="{Binding ClassCanvas.Classes}"
                          PointerPressed="OnCanvasClicked"
                          Height="5000"
                          Width="5000">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas  Name="MainCanvas" Background="LightGray" Height="5000" Width="2500"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter" x:DataType="vm:UMLClassViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="MainContainer UMLClass"
                                Classes.Selected="{Binding IsSelected}"
                                PointerPressed="OnUMLClassClicked"
                                PointerMoved="OnUMLClassMoved"
                                PointerReleased="OnUMLClassReleased"
                                Width="{Binding Width}">
                            <StackPanel>
                                <Border Classes="UMLClassSection FullBorder"
                                        Height="{Binding TitleHeight}">
                                    <Panel>
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding !IsEditingTitle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="Black"
                                                   PointerPressed="OnClassTitleClicked"/>
                                        <TextBox   Text="{Binding Title}"
                                                   IsVisible="{Binding IsEditingTitle}"
                                                   HorizontalAlignment="Stretch"
                                                   TextWrapping="Wrap"
                                                   AcceptsReturn="True"
                                                   LostFocus="OnClassTitleLostFocus"
                                                   KeyDown="OnClassTitleKeyDown"/>
                                    </Panel>
                                </Border>
                                <Border Classes="UMLClassSection NoTopBorder"
                                        Height="{Binding AttributeHeight}">
                                    <Panel>
                                        <TextBlock Text="{Binding AttributesString}"
                                                   Classes="AttributesDisplayText"
                                                   IsVisible="{Binding !IsEditingAttributes}"
                                                   TextWrapping="Wrap"
                                                   Foreground="Black"
                                                   PointerPressed="OnClassAttributesClicked"/>
                                        <TextBox   Text="{Binding AttributesString}"
                                                   IsVisible="{Binding IsEditingAttributes}"
                                                   HorizontalAlignment="Stretch"
                                                   AcceptsReturn="True"
                                                   TextWrapping="Wrap"
                                                   LostFocus="OnClassAttributesLostFocus"
                                                   KeyDown="OnClassAttributesKeyDown"/>
                                        <Border    Classes="ResizeHandle"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   PointerPressed="OnResizeAttributesHandleClicked"
                                                   PointerMoved="OnResizeAttributesHandleMoved"
                                                   PointerReleased="OnResizeHandleReleased"/>

                                    </Panel>
                                </Border>
                                <Border Classes="UMLClassSection NoTopBorder"
                                        Height="{Binding MethodHeight}">
                                    <Panel>
                                        <TextBlock Text="{Binding MethodsString}"
                                                   Classes="MethodsDisplayText"
                                                   IsVisible="{Binding !IsEditingMethods}"
                                                   TextWrapping="Wrap"
                                                   Foreground="Black"
                                                   PointerPressed="OnClassMethodsClicked"/>
                                        <TextBox   Text="{Binding MethodsString}"
                                                   IsVisible="{Binding IsEditingMethods}"
                                                   HorizontalAlignment="Stretch"
                                                   AcceptsReturn="True"
                                                   TextWrapping="Wrap"
                                                   LostFocus="OnClassMethodsLostFocus"
                                                   KeyDown="OnClassMethodsKeyDown"/>
                                        <Border    Classes="ResizeHandle"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   PointerPressed="OnResizeMethodsHandleClicked"
                                                   PointerMoved="OnResizeMethodsHandleMoved"
                                                   PointerReleased="OnResizeHandleReleased"/>
                                    </Panel>

                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        
        </ScrollViewer>

    </Grid>

</Window>
